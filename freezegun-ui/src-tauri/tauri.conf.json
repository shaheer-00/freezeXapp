{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freezeXapp",
  "version": "0.1.0",
  "identifier": "com.shaheer.freezexapp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FreezeGun",
        "width": 1180,
        "height": 720,
        "minWidth": 820,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#050806"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
